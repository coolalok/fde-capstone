# Copy this to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# Model provider (OpenRouter free tier)
OPENROUTER_API_KEY=your_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
# This model has no ':free' suffix, so it is BILLED; an OpenRouter account with no credit cannot run it.
# A judge on a different provider needs its own GUARDRAIL_BASE_URL and GUARDRAIL_API_KEY: keys never fall back across providers.
# Judge model for the guardrails — must NOT be the generator model (see D-08/Bug 5).
GUARDRAIL_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Provider endpoint. Defaults to OpenRouter (D-01, cost-nothing rule) — leave
# these commented out for the graded submission. Uncomment ONLY to point a paid
# endpoint at the pipeline for diagnosis; results from another provider are a
# separate experiment, not an update to the llama-3.1-8b measurements.
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=sk-...
# MODEL_NAME=gpt-4o-mini
# GUARDRAIL_MODEL=gpt-4o-mini

# Embeddings (local, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
DECISION_LOG_TIMEOUT_SECONDS=30.0

# Model call bounds — A9 requires an unattended run to terminate. The SDK
# default is 600s with 2 retries; a hung call would stall the harness.
MODEL_TIMEOUT_SECONDS=60.0
MODEL_MAX_RETRIES=5

# Runtime
LOG_LEVEL=INFO
# Set by measurement (D-05b, B-16 sweep). Precision floor unmet — see the ADR.
CONFIDENCE_THRESHOLD=0.85
RETRIEVAL_TOP_K=5
# Calibrated against cosine relevance scores (D-02a). Rebuild the index after
# changing the distance space, and re-run the sweep before changing this.
RETRIEVAL_THRESHOLD=0.25

# Monitoring — Prometheus /metrics port during a harness run (Setup Guide §06).
# 0 or unset = do not start the server. See docs/monitoring.md.
METRICS_PORT=0

# Model response cache (Build Spec: "Caching is encouraged"; D-08). A hit costs
# no tokens and no quota, so a re-run on a throttled free tier is affordable.
# Set MODEL_CACHE_DISABLED=1 for a gate run that must measure live behaviour.
MODEL_CACHE_DIR=./storage/model_cache
MODEL_CACHE_DISABLED=0
