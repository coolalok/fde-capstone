# Copy this to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# Model provider (OpenRouter)
OPENROUTER_API_KEY=your_key_here
# NOTE ON COST: this model has no ':free' suffix, so it is BILLED — about
# $0.05 per million prompt tokens, roughly $0.10 for a full 80-ticket gate
# run. It is not free, and an account with a zero balance cannot run it.
# There is no free Llama variant on OpenRouter; the ':free' models are a
# different set entirely (see GUARDRAIL_MODEL below). D-01's cost rule should
# be read as 'negligible', not 'zero'.
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
# Judge model for the guardrails — must NOT be the generator model (D-08/Bug 5).
GUARDRAIL_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# The judge's endpoint and key, if it lives on a different PROVIDER from the
# generator. Both fall back to MODEL_BASE_URL / MODEL_API_KEY when unset, so
# leaving them blank keeps the single-provider behaviour.
#
# Why this exists: OpenRouter caps models whose id ends in ':free' at 50
# requests/day for accounts that have never bought 10 credits (20/min either
# way — see https://openrouter.ai/docs/api-reference/limits). The three LLM
# guardrails make 3 calls per ticket, so the daily allowance is ~16 tickets.
# An 80-ticket gate needs 240 judge calls and cannot run on it. Exhausting the
# quota does NOT surface as bad answers — every guardrail fails safe and
# blocks, which reads as rampant fabrication. That is what produced the 70/80
# block rate on 8 Sep.
#GUARDRAIL_BASE_URL=https://api.openai.com/v1
#GUARDRAIL_API_KEY=your_judge_provider_key_here

# Provider endpoint. Defaults to OpenRouter (D-01, cost-nothing rule) — leave
# these commented out for the graded submission. Uncomment ONLY to point a paid
# endpoint at the pipeline for diagnosis; results from another provider are a
# separate experiment, not an update to the llama-3.1-8b measurements.
#MODEL_BASE_URL=https://api.openai.com/v1
#MODEL_API_KEY=your_paid_provider_key_here
#MODEL_NAME=gpt-4o-mini
#GUARDRAIL_MODEL=gpt-4o

# Embeddings (local, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
DECISION_LOG_TIMEOUT_SECONDS=30.0

# Model call bounds — A9 requires an unattended run to terminate. The SDK
# default is 600s with 2 retries; a hung call would stall the harness.
MODEL_TIMEOUT_SECONDS=60.0
MODEL_MAX_RETRIES=2

# Runtime
LOG_LEVEL=INFO
# Set by measurement (D-05b, B-16 sweep). Precision floor unmet — see the ADR.
CONFIDENCE_THRESHOLD=0.85
RETRIEVAL_TOP_K=5
# Calibrated against cosine relevance scores (D-02a). Rebuild the index after
# changing the distance space, and re-run the sweep before changing this.
RETRIEVAL_THRESHOLD=0.25
